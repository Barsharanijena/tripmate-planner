GEMINI_API_KEY=
TAVILY_API_KEY=
AVIATIONSTACK_API_KEY=
DEFAULT_ORIGIN_CITY=Pune

# Optional: omit to checkpoint trip threads in memory only (fine for local dev)
DATABASE_URL=

# Optional: get a free key at smith.langchain.com to trace every graph run
# (per-node inputs/outputs, token usage, latency). Omit to run untraced.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tripmate-planner
